  m_Script: {fileID: 11500000, guid: c65557a6670d2cf45867eae17f2f98a8, type: 3}
  m_Name: "\uAC8C\uC784\uC744 \uC88B\uC544\uD558\uB294 \uC18C\uB144 \uD018"
  m_EditorClassIdentifier: 
  questID: Quest6
  questName: "\uAC8C\uC784\uC744 \uC88B\uC544\uD558\uB294 \uC18C\uB144"
  description: "\uD018\uC2A4\uD2B8\uB97C \uC644\uB8CC\uD558\uC138\uC694."
  objective:
    type: 0
    targetItemID: Item_D
    targetItemQuantity: 1
    targetNPCName: 
    targetLikability: 0
  rewardGold: 0
  rewardLikability: 100
  rewardItem: {fileID: 0}
  rewardItemQuantity: 0
  startDialogue:
    name: "\uAC8C\uC784\uC744 \uC88B\uC544\uD558\uB294 \uC18C\uB144"
    lines:
    - isPlayer: 1
      sentence: "(\uCEF4\uD4E8\uD130\uC2E4\uC5D0\uC11C \uD55C \uC18C\uB144 \uBC1C\uACAC\uD588\uB2E4.)\r"
      choices: []
    - isPlayer: 1
      sentence: "\uC774\uAC70 \uBB34\uC2A8 \uAC8C\uC784\uC774\uC57C?"
      choices: []
    - isPlayer: 0
      sentence: "\uC5B4\u2026? \uC5B4\u2026 \uC774\uAC70 \uCD5C\uADFC\uC5D0 \uB098\uC654\uB358
        \uAC8C\uC784\uC778\uB370 \uB09C \uD560 \uC218 \uC5C6\uC5B4\uC11C \uC601\uC0C1\uC73C\uB85C\uB9CC
        \uBCF4\uACE0 \uC788\uC5B4\u2026."
      choices: []
    - isPlayer: 1
      sentence: "\uC65C \uBABB\uD574? \uD310\uB9E4\uD560 \uB54C \uAE5C\uBE61\uD558\uACE0
        \uBABB \uC0C0\uC5B4?"
      choices: []
    - isPlayer: 0
      sentence: "\uADF8\uAC74 \uC544\uB2C8\uACE0\u2026 \uD55C\uC815\uD310\uC73C\uB85C
        \uD328\uD0A4\uC9C0 \uAC8C\uC784\uC744 \uC0C0\uC5C8\uB294\uB370 \uC783\uC5B4\uBC84\uB838\uC5B4\u2026
        \uBD84\uBA85 \uADF8 \uB0A0 \uC544\uCE68\uC5D0 \uC0AC\uACE0 \uD559\uAD50 \uC0AC\uBB3C\uD568\uC5D0
        \uB450\uC5C8\uB358 \uAC83 \uAC19\uC740\uB370\u2026. \uC5C6\uC5B4\uC84C\uC5B4\u2026
        \uB2E4 \uCC3E\uC544\uBD24\uB294\uB370\u2026 \uB610 \uC0B4 \uB3C8\uB3C4 \uC5C6\uACE0\u2026. "
      choices: []
    - isPlayer: 1
      sentence: "\uC800\uB7F0\u2026 \uB098\uB3C4 \uD55C \uBC88 \uCC3E\uC544\uBD10\uC904\uAC8C!
        \uB108\uBB34 \uAC71\uC815\uD558\uC9C0\uB9C8~"
      choices: []
    - isPlayer: 1
      sentence: "\uADF8\uB798\u2026 \uACE0\uB9C8\uC6CC\u2026. \uCC3E\uC73C\uBA74
        \uC88B\uACA0\uB2E4\u2026"
      choices:
      - choiceText: "(\uB9E4\uC810\uC5D0\uC11C \uBCF8 \uAC83 \uAC19\uAE30\uB3C4...)"
        likabilityChange: 0
        action: 1
  completionDialogue:
    name: "\uAC8C\uC784\uC744 \uC88B\uC544\uD558\uB294 \uC18C\uB144"
    lines:
    - isPlayer: 0
      sentence: "\uC815\uB9D0 \uACE0\uB9C8\uC6CC!"
      choices:
      - choiceText: "\uB2E4\uC74C\uC5D4 \uC783\uC5B4\uBC84\uB9AC\uC9C0\uB9C8!"
        likabilityChange: 0
        action: 0
