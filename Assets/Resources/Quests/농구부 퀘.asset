  startDialogue:
    name: "\uB18D\uAD6C\uBD80"
    lines:
    - isPlayer: 1
      sentence: "(\uC6B4\uB3D9\uC7A5\uC5D0\uC11C \uB18D\uAD6C \uC5F0\uC2B5 \uC911\uC5D0
        \uC26C\uB294 \uC911\uC778 \uC5D0\uC774\uC2A4 \uBC1C\uACAC\uD588\uB2E4.)"
      choices: []
    - isPlayer: 1
      sentence: "\uB18D\uAD6C \uC5C4\uCCAD \uC5F4\uC2EC\uD788 \uD558\uB124?"
      choices: []
    - isPlayer: 0
      sentence: "\uACE7 \uACBD\uAE30\uB2C8\uAE4C \uC5F0\uC2B5 \uACC4\uC18D \uD574\uC57C\uC9C0.
        \uBC25\uB3C4 \uBABB \uBA39\uC5C8\uC5B4."
      choices: []
    - isPlayer: 1
      sentence: "\uC9C4\uC9DC? \uADF8\uB798\uB3C4 \uBC25\uC740 \uBA39\uC73C\uBA74\uC11C
        \uD574\uC57C \uD798\uC774 \uB098\uC9C0~"
      choices: []
    - isPlayer: 0
      sentence: "\uAD1C\uCC2E\uC544 \uC774\uB530\uAC00 \uAC04\uB2E8\uD558\uAC8C \uBA39\uC73C\uBA74
        \uB3FC."
      choices: []
    - isPlayer: 1
      sentence: " \u2026. \n\r\n(\uB9E4\uC810\uC5D0\uC11C \uBB34\uC5B8\uAC00 \uC0AC\uB2E4\uC8FC\uBA74
        \uC88B\uC544\uD560 \uAC83 \uAC19\uB2E4.)\r"
      choices:
      - choiceText: "\uC608\uB97C \uB4E4\uBA74 \uC5D0\uB108\uC9C0\uBC14..?"
        likabilityChange: 0
        action: 1
  completionDialogue:
    name: "\uB18D\uAD6C\uBD80"
    lines:
    - isPlayer: 0
      sentence: "\uB9C8\uCE68 \uBC30\uACE0\uD320\uB294\uB370 \uACE0\uB9C8\uC6CC!"
