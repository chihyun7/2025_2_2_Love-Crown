  m_Name: "\uBBF8\uC220\uBD80 \uC18C\uB144 \uD018"
  m_EditorClassIdentifier: 
  questID: Quest7
  questName: "\uBBF8\uC220\uBD80 \uC18C\uB144"
  description: "\uD018\uC2A4\uD2B8\uB97C \uC644\uB8CC\uD558\uC138\uC694."
  objective:
    type: 0
    targetItemID: Item_E
    targetItemQuantity: 1
    targetNPCName: 
    targetLikability: 0
  rewardGold: 0
  rewardLikability: 100
  rewardItem: {fileID: 0}
  rewardItemQuantity: 0
  startDialogue:
    name: "\uBBF8\uC220\uBD80 \uC18C\uB144"
    lines:
    - isPlayer: 1
      sentence: "(\uBBF8\uC220\uC2E4\uC5D0\uC11C \uADF8\uB9BC \uADF8\uB9AC\uB294
        \uC911\uC778 \uC18C\uB144\uC744 \uBC1C\uACAC\uD588\uB2E4.)\r"
      choices: []
    - isPlayer: 1
      sentence: "\uBB50 \uADF8\uB9AC\uACE0 \uC788\uC5B4?"
      choices: []
    - isPlayer: 0
      sentence: "\uC548\uB155~ \uC9C0\uAE08 \uC6B0\uB9AC \uBD80\uBAA8\uB2D8 \uADF8\uB9AC\uACE0
        \uC788\uC5B4."
      choices: []
    - isPlayer: 1
      sentence: "\uC640~ \uB108 \uADF8\uB9BC \uC9C4\uC9DC \uC798 \uADF8\uB9B0\uB2E4.
        \uBD80\uBAA8\uB2D8\uD55C\uD14C \uB4DC\uB9B4 \uC120\uBB3C\uC774\uC57C?"
      choices: []
    - isPlayer: 0
      sentence: "\uB9DE\uC544 \u314E\u314E \uC624\uB298 \uC0DD\uC77C\uC778\uB370
        \uB0B3\uC544\uC8FC\uC2DC\uACE0 \uD0A4\uC6CC\uC8FC\uC154\uC11C \uAC10\uC0AC\uD55C
        \uB9C8\uC74C\uC5D0 \uB4DC\uB9AC\uB824\uACE0."
      choices: []
    - isPlayer: 1
      sentence: "\uB108 \uC624\uB298 \uC0DD\uC77C\uC774\uC600\uC5B4?! \uBAB0\uB790\uC5B4
        \uBBF8\uC548\uD574. \uC0DD\uC77C \uCD95\uD558\uD574~"
      choices: []
    - isPlayer: 0
      sentence: "\uACE0\uB9C8\uC6CC~ \uC624\uB298 \uCC98\uC74C \uCD95\uD558\uBC1B\uC558\uB124."
      choices: []
    - isPlayer: 1
      sentence: "\uC815\uB9D0? \uC560\uB4E4\uC774 \uB2E4 \uAE5C\uBE61\uD588\uB098\uBCF4\uB124\u2026."
      choices: []
    - isPlayer: 0
      sentence: "\uAD1C\uCC2E\uC544\u2026 \uBB50 \uC0DD\uC77C\uC774 \uB300\uC218\uB77C\uACE0\u2026.
        (\uC6C3\uC5B4\uBCF4\uC774\uC9C0\uB9CC \uC5B4\uB518\uAC00 \uC2AC\uD37C\uBCF4\uC778\uB2E4.)"
      choices: []
    - isPlayer: 1
      sentence: "\uC7A0\uAE50 \uAE30\uB2E4\uB824\uBD10! "
      choices:
      - choiceText: "(\uC904 \uBA85\uD654\uC9D1\uC744 \uCC3E\uC544\uBCF4\uC790.)"
        likabilityChange: 0
        action: 1
  completionDialogue:
    name: "\uBBF8\uC220\uBD80 \uC18C\uB144"
    lines:
    - isPlayer: 0
      sentence: "\uC774\uAC74... \uC815\uB9D0 \uACE0\uB9C8\uC6CC!"
      choices: []
    - isPlayer: 1
      sentence: "\uBCC4\uB9D0\uC500\uC744."
      choices: []
