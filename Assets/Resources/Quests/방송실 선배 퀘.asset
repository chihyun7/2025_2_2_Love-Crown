  startDialogue:
    name: "\uBC29\uC1A1\uC2E4 \uC120\uBC30"
    lines:
    - isPlayer: 1
      sentence: "(\uC9C0\uB098\uAC00\uB358 \uBC29\uC1A1\uC2E4\uC5D0\uC11C \uBB34\uC5B8\uAC00\uB97C
        \uCC3E\uACE0 \uC788\uB294 \uC120\uBC30\uB97C \uBC1C\uACAC\uD588\uB2E4.)"
      choices: []
    - isPlayer: 0
      sentence: "\uC5B4 \uD6C4\uBC30\uB2D8 \uC5B4\uB514\uAC00\uC694?? \uD639\uC2DC
        \uBC14\uBE60?"
      choices: []
    - isPlayer: 1
      sentence: "\uC5B4 \uC120\uBC30\uB2D8 \uC65C\uADF8\uB7EC\uC138\uC694?"
      choices: []
    - isPlayer: 0
      sentence: "\uC544 \uADF8\uAC8C \uC774\uB530\uAC00 \uBC29\uC1A1\uC744 \uD574\uC57C\uB418\uB294\uB370
        \uC9C0\uAE08 \uB9C8\uC774\uD06C\uAC00 \uC0AC\uB77C\uC838\uC11C \uD639\uC2DC
        \uAC19\uC774 \uCC3E\uC544\uC904\uB798?"
      choices: []
    - isPlayer: 1
      sentence: "\uB3C4\uC640\uC8FC\uBA74 \uC800 \uBC25 \uD55C \uBC88 \uC0AC\uC8FC\uC2DC\uB294\uAC70\uC5D0\uC694?"
      choices: []
    - isPlayer: 0
      sentence: "\uC5B4\u2026 \uC77C\uB2E8 \uC54C\uC558\uC73C\uB2C8\uAE4C \uBE68\uB9AC
        \uB3C4\uC640\uC918 \uC2DC\uAC04\uC774 \uC5C6\uC5B4\u2026"
      choices:
      - choiceText: "(\uB9C8\uC774\uD06C\uB97C  \uCC3E\uC544\uBCF4\uC790.)"
        likabilityChange: 0
        action: 1
  completionDialogue:
    name: "\uBC29\uC1A1\uC2E4 \uC120\uBC30"
    lines:
    - isPlayer: 0
      sentence: "\uACE0\uB9C8\uC6CC. \uB355\uBD84\uC5D0 \uC0B4\uC558\uC5B4."
      choices: []
    - isPlayer: 1
      sentence: "\uBC25 \uC0AC\uC8FC\uC2DC\uB294\uAC70 \uC78A\uC73C\uBA74 \uC548\uB3FC\uC694?"
      choices: []
    - isPlayer: 0
      sentence: "\uC54C\uC558\uC5B4. \uC774\uB9CC \uAC00\uBD10."
      choices: []
