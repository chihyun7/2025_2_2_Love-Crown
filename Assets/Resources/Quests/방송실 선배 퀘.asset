  questID: Quest10
  questName: "\uBC29\uC1A1\uC2E4 \uC120\uBC30"
  description: "\uD018\uC2A4\uD2B8\uB97C \uC644\uB8CC\uD558\uC138\uC694."
  objective:
    type: 0
    targetItemID: Item_G
    targetItemQuantity: 1
