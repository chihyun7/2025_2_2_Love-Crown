  m_Script: {fileID: 11500000, guid: c65557a6670d2cf45867eae17f2f98a8, type: 3}
  m_Name: "\uBC34\uB4DC\uBD80 \uC120\uBC30 \uD018"
  m_EditorClassIdentifier: 
  questID: Quest8
  questName: "\uBC34\uB4DC\uBD80 \uC120\uBC30"
  description: "\uD018\uC2A4\uD2B8\uB97C \uC644\uB8CC\uD558\uC138\uC694."
  objective:
    type: 0
    targetItemID: Item_C
    targetItemQuantity: 1
    targetNPCName: 
    targetLikability: 0
  rewardGold: 0
  rewardLikability: 100
  rewardItem: {fileID: 0}
  rewardItemQuantity: 0
  startDialogue:
    name: "\uBC34\uB4DC\uBD80 \uC120\uBC30"
    lines:
    - isPlayer: 1
      sentence: "\uC120\uBC30 \uC65C \uC774\uB807\uAC8C \uAE30\uC6B4\uC774 \uC5C6\uC5B4\uC694?"
      choices: []
    - isPlayer: 0
      sentence: "\uC5B4? \uADF8\uB798\uBCF4\uC774\uB098? \uD558\uD558 \uC0AC\uC2E4
        \uB0B4\uAC00 \uAC00\uC7A5 \uC544\uB07C\uB358 \uCC45\uC774 \uC0AC\uB77C\uC838\uC11C..
        \uC9D1\uC5D0 \uB450\uACE0 \uC654\uB294\uC9C0 \uC548\uBCF4\uC774\uB124"
      choices: []
    - isPlayer: 1
      sentence: "\uC120\uBC30\uB3C4 \uBB58 \uC783\uC5B4\uBC84\uB838\uC5B4\uC694?
        \uC624\uB298 \uBB34\uC5B8\uAC00 \uC783\uC5B4\uBC84\uB9AC\uB294 \uC0AC\uB78C\uB4E4
        \uB9CE\uB124.."
      choices: []
    - isPlayer: 0
      sentence: "\uC751? \uB098 \uB9D0\uACE0 \uB610 \uB204\uAC00 \uC783\uC5B4\uBC84\uB838\uC5B4? "
      choices: []
    - isPlayer: 1
      sentence: "\uC544\uB2C8\uC5D0\uC694~ \uC81C\uAC00 \uB2E4 \uCC3E\uC544\uC92C\uAC70\uB4E0\uC694.
        \uC120\uBC30 \uCC45\uB3C4 \uC81C\uAC00 \uD55C \uBC88 \uCC3E\uC544\uBCFC\uAC8C\uC694!"
      choices: []
    - isPlayer: 0
      sentence: "\uC751 \uD55C \uBC88 \uC2DC\uAC04\uB098\uBA74 \uCC3E\uC544\uBD10\uC8FC\uBA74
        \uB108\uBB34 \uACE0\uB9C8\uC6B8 \uAC83 \uAC19\uB124."
      choices:
      - choiceText: "(\uCC45\uC744 \uD55C\uBC88 \uCC3E\uC544\uBCFC\uAE4C?)"
        likabilityChange: 0
        action: 1
  completionDialogue:
    name: "\uBC34\uB4DC\uBD80 \uC120\uBC30"
    lines:
    - isPlayer: 1
      sentence: "\uC774\uAC70 \uC120\uBC30 \uCC45 \uB9DE\uC544\uC694?"
      choices: []
    - isPlayer: 0
      sentence: "\uC624! \uD559\uAD50\uC5D0 \uC788\uC5C8\uB098\uBCF4\uB124 \uC544
        \uC544\uAE4C \uC774\uB3D9\uD558\uB2E4\uAC00 \uB5A8\uC5B4\uB728\uB838\uB098
        \uBD10 \uB2E4\uD589\uC774\uB2E4."
      choices: []
    - isPlayer: 0
      sentence: "\uB108\uAC00 \uCC3E\uC544\uC900 \uAC70 \uC78A\uC9C0 \uC54A\uC744\uAC8C
        \uACE0\uB9C8\uC6CC."
      choices: []
