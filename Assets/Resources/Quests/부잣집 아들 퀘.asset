  m_Name: "\uBD80\uC7A3\uC9D1 \uC544\uB4E4 \uD018"
  m_EditorClassIdentifier: 
  questID: Quest1
  questName: "\uBD80\uC7A3\uC9D1 \uC544\uB4E4"
  description: "\uD018\uC2A4\uD2B8\uB97C \uC644\uB8CC\uD558\uC138\uC694."
  objective:
    type: 0
    targetItemID: Item_F
    targetItemQuantity: 1
    targetNPCName: "\uBD80\uC7A3\uC9D1 \uC544\uB4E4"
    targetLikability: 0
  rewardGold: 0
  rewardLikability: 100
  rewardItem: {fileID: 0}
  rewardItemQuantity: 1
  startDialogue:
    name: "\uBD80\uC7A3\uC9D1 \uC544\uB4E4"
    lines:
    - isPlayer: 0
      sentence: "\uC5B4\uB514\uAC04\uAC70\uC57C \uB300\uCCB4\u2026."
      choices: []
    - isPlayer: 1
      sentence: "\uBB50 \uCC3E\uC544?"
      choices: []
    - isPlayer: 0
      sentence: "\uB0B4 \uC9C0\uAC11\uC774 \uC0AC\uB77C\uC838\uBC84\uB838\uC5B4..
        \uBD84\uBA85 \uD559\uAD50 \uC62C\uB54C\uAE4C\uC9C0\uB9CC \uD574\uB3C4 \uC8FC\uBA38\uB2C8\uC5D0
        \uC788\uC5C8\uB294\uB370"
      choices: []
    - isPlayer: 1
      sentence: "\uD5D0 \uBE68\uB9AC \uCC3E\uC544\uC57C\uB418\uACA0\uB124"
      choices: []
    - isPlayer: 0
      sentence: "\uACC4\uC18D \uCC3E\uC544\uBD24\uB294\uB370 \uC5C6\uC5B4\u2026 \uC548\uC5D0
        \uB3C8\uC774\uB791 \uCE74\uB4DC \uB2E4 \uB4E4\uC5B4\uC788\uB294\uB370.."
      choices: []
    - isPlayer: 1
      sentence: "\uB098\uB3C4 \uCC3E\uB294\uAC70 \uB3C4\uC640\uC904\uAC8C! \uCC3E\uC544\uBCF4\uACE0
        \uCC3E\uC73C\uBA74 \uAC00\uC838\uB2E4\uC904\uAC8C \uAE30\uB2E4\uB824!"
      choices:
      - choiceText: "(\uC9C0\uAC11\uC744 \uCC3E\uC544\uBCF4\uC790.)"
        likabilityChange: 0
        action: 1
  completionDialogue:
    name: "\uBD80\uC7A3\uC9D1 \uC544\uB4E4"
    lines:
    - isPlayer: 1
      sentence: "\uC774\uAC70 \uB108 \uC9C0\uAC11 \uB9DE\uC9C0? \uBC16\uC5D0 \uB5A8\uC5B4\uC838\uC788\uB354\uB77C
        \uACA8\uC6B0 \uCC3E\uC558\uC5B4 \uD734\u2026"
      choices: []
    - isPlayer: 0
      sentence: "\uC640 \uC774\uAC70 \uB0B4 \uC9C0\uAC11 \uB9DE\uC544! \uC9C4\uC9DC
        \uB108\uBB34 \uACE0\uB9C8\uC6CC \uB108 \uAC83\uB3C4 \uC544\uB2CC\uB370 \uC774\uB807\uAC8C
        \uC5F4\uC2EC\uD788 \uCC3E\uC544\uC8FC\uB2E4\uB2C8.."
      choices: []
    - isPlayer: 1
      sentence: "\uACE0\uB9C8\uC6B0\uBA74 \uB098\uC911\uC5D0 \uBC25 \uD55C\uBC88
        \uC0AC~ \uB9DB\uC788\uB294\uAC70 \uBA39\uC790!"
      choices: []
    - isPlayer: 0
      sentence: "\uC5B4? \uC5B4 \uADF8\uB798 \uB0B4\uAC00 \uB9DB\uC788\uB294\uAC70
        \uC0AC\uC904\uAC8C"
      choices: []
