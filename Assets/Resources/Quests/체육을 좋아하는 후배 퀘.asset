  startDialogue:
    name: "\uCCB4\uC721\uC744 \uC88B\uC544\uD558\uB294 \uD6C4\uBC30"
    lines:
    - isPlayer: 1
      sentence: "(\uD798\uB4E4\uC5B4\uC11C \uB204\uC6CC\uC788\uB294 \uD6C4\uBC30\uB97C
        \uBC1C\uACAC\uD588\uB2E4.)\r\n"
      choices: []
    - isPlayer: 1
      sentence: "\uD6C4\uBC30\uB2D8~ \uC5EC\uAE30\uC11C \uB204\uC6CC\uC11C \uBB50\uD558\uC138\uC694~?\r"
      choices: []
    - isPlayer: 0
      sentence: "\uD5E5\u2026\uD5C9.. \uB204\uB098 \uC800 \uC8FD\uC744 \uAC83 \uAC19\uC544\uC694\u2026
        \uBB3C \uC880.. \uC55E\uC774 \uC548\uBCF4\u2026."
      choices: []
    - isPlayer: 1
      sentence: "\uC5B4\uC774 \uD6C4\uBC30\uB2D8? \uC5B4\uB77C? \uC57C! "
      choices:
      - choiceText: "(\uBB3C\uC744 \uAC00\uC838\uB2E4\uC8FC\uC790.) "
        likabilityChange: 0
        action: 1
  completionDialogue:
    name: "\uCCB4\uC721\uC744 \uC88B\uC544\uD558\uB294 \uD6C4\uBC30"
