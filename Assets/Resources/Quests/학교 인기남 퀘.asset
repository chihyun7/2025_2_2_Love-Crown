  rewardItemQuantity: 0
  startDialogue:
    name: "\uD559\uAD50 \uC778\uAE30\uB0A8"
    lines:
    - isPlayer: 0
      sentence: "\uC774 \uBA38\uB9AC\uB860 \uB3CC\uC544\uB2E4\uB2D0 \uC218 \uC5C6\uC5B4\u2026
        \uC9C0\uAE08\uC774\uB77C\uB3C4 \uC9D1\uC5D0 \uAC08\uAE4C?\n\uC5B4\uB5BB\uAC8C
        \uD558\uC9C0? \uD558\uC544\u2026"
      choices: []
    - isPlayer: 1
      sentence: "\uC5EC\uAE30\uC11C \uBB50\uD574?"
      choices: []
    - isPlayer: 0
      sentence: "\uC73C\uC544\uC544\uC545!!! \uBCF4\uC9C0\uB9C8!!\r\n"
      choices: []
    - isPlayer: 1
      sentence: "\uBB50\uB97C?"
      choices: []
    - isPlayer: 0
      sentence: "\uC544\uCE68\uC5D0 \uBA38\uB9AC\uB97C \uC798\uBABB \uB9D0\uB824\uC11C
        \uBA38\uB9AC\uAC00 \uC774\uC0C1\uD574\uC84C\uC5B4.\n\uC560\uB4E4\uB3C4 \uBCF4\uACE0
        \uB2E4 \uBE44\uC6C3\uC5C8\uB2E4\uACE0.. \r"
      choices: []
    - isPlayer: 1
      sentence: "\uC5D0\uC774 \uBA38\uB9AC\uAC00 \uBB34\uC2A8 \uC0C1\uAD00\uC774\uC57C~
        \uC798\uBABB \uB9D0\uB9B4 \uC218\uB3C4 \uC788\uC9C0. \r"
      choices: []
    - isPlayer: 0
      sentence: "\uADF8\uB3D9\uC548 \uD56D\uC0C1 \uC544\uCE68\uC5D0 \uC2E0\uACBD\uC368\uC11C
        \uC798 \uAFB8\uBBF8\uACE0 \uC654\uB294\uB370 \uC624\uB298\uC740.. \uC218\uC5C5\uB3C4
        \uBABB \uB4E3\uACA0\uC5B4"
      choices: []
    - isPlayer: 1
      sentence: "\uC7A0\uAE50 \uAE30\uB2E4\uB824\uBD10 \uB0B4\uAC00 \uBE57\uC5B4\uC904\uAC8C"
      choices:
      - choiceText: "(\uAF2C\uB9AC\uBE57\uC774\uBA74 \uB418\uACA0\uC9C0?)"
        likabilityChange: 0
        action: 1
  completionDialogue:
    name: "\uD559\uAD50 \uC778\uAE30\uB0A8"
    lines:
    - isPlayer: 1
      sentence: "\uC790~ \uC5B4\uB54C? \uAD1C\uCC2E\uC9C0?"
      choices: []
    - isPlayer: 0
      sentence: "\u2026.\uC751 \uAD1C\uCC2E\uC544\uC84C\uB124..\r"
      choices: []
    - isPlayer: 1
      sentence: "\uC774\uC81C \uB108\uBB34 \uC2E0\uACBD\uC4F0\uC9C0 \uB9D0\uACE0
        \uB2E4\uB140\uB3C4 \uB3FC \uAF2C\uB9AC\uBE57\uC740 \uC120\uBB3C\uB85C \uC904\uAC8C~"
      choices: []
    - isPlayer: 0
      sentence: "\uC751.. \uACE0\uB9C8\uC6CC! "
      choices: []
